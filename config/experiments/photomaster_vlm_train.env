# Experiment config for Qwen3-VL-32B LoRA SFT.
# Source with: source config/experiments/photomaster_vlm_train.env
# Then run:    bash scripts/vlm_train/launch_qwen3_vl_train.sh

DATASET_NAME=lingbot_captionV3,forwardPipeline_captionV3
OUTPUT_PATH=outputs/qwen3vl32b_lora_lingbotForward_captionV3

LEARNING_RATE=1e-5
NUM_TRAIN_EPOCHS=3
PER_DEVICE_TRAIN_BATCH_SIZE=1
GRADIENT_ACCUMULATION_STEPS=1
SAVE_STEPS=1000
CUTOFF_LEN=2048
IMAGE_MAX_PIXELS=262144
MASTER_PORT=39987
