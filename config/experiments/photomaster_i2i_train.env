# Qwen-Image-Edit-2511 training — lingbot caption-V3 ablation.
#
# Sourced by scripts/dit_train/train_qwen_edit_2511.slurm.
# Every value here is also a plain environment variable, so it can be overridden
# by exporting it before submission or by copying this file and editing it.

# Dataset. 
DATA_CONFIG_PATH=config/data/photomaster_data.yaml

# Where checkpoints, training_log.txt and training_config/ are written.
OUTPUT_PATH=outputs/photomaster_i2i_ft

# Optimization
LEARNING_RATE=1e-5
NUM_EPOCHS=2
BATCH_SIZE_PER_GPU=1
GRADIENT_ACCUMULATION_STEPS=1

# Save a checkpoint every N optimizer steps. Each checkpoint is ~40.8 GB.
CHECKPOINTING_STEPS=50

# Resolution bucketing preset.
#
# Production uses qwen_edit_2511_native. That preset needs ~74 GB of an 80 GB card
# and only fits at 64 GPUs, because ZeRO-2 shards optimizer state across ranks and
# per-GPU memory therefore grows as the world shrinks. At 24 GPUs it OOMs, so this
# ablation config uses the 1024 preset. Raise it back to qwen_edit_2511_native when
# running at 8 nodes / 64 GPUs.
QWEN_TRAIN_RESOLUTION_PRESET=qwen_edit_1024

# Allocator fragmentation mitigation -- see the GPU memory section of the README.
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# Rendezvous port. Moved off the 21638 default because an aborted run can leave
# that port in TIME_WAIT and fail the next submit with EADDRINUSE.
MASTER_PORT=29517
