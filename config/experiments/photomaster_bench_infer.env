# Inference settings for the photomaster_bench reference run.
#
# Source before launching the pipeline:
#   set -a; . config/experiments/photomaster_bench_infer.env; set +a
#
# These generation values were used for the recorded H20 one-image and five-image
# runs. See docs/gpu-validation.md for environment, model revisions and source scope.

# Model paths are not set here: every stage defaults into <repo>/models/, so a populated
# models/ directory needs none of them. Set MODEL_ROOT or MODEL_PATH on the stage script
# to reach checkpoints elsewhere. Stage 3 defaults to the published PhotoMaster
# full transformer; custom FT_CKPT_PATH values also need the intended FT_CKPT_IS_FULL mode.

# --- Stage 1: VLM ---
BENCH=photomaster_bench
MAX_NEW_TOKENS=2048
TEMPERATURE=0.7
TOP_P=0.8
TOP_K=20

# --- Stage 3: DiT ---
TRUE_CFG_SCALE=4.0
INFERENCE_STEPS=50
SEED=0
QWEN_OUTPUT_RESOLUTION=1328
QWEN_VAE_INPUT_RESOLUTION=1328
